{
  "name": "warden-ai-security",
  "version": "1.0.0",
  "private": true,
  "description": "Warden local AI security UI",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node server.ts",
    "start-server": "ts-node server.ts",
    "start-server:prod": "node dist/server.js",
    "build-server": "tsc -p tsconfig.json",
    "install-server-deps": "npm install express body-parser node-fetch@2 dotenv @google/genai"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "body-parser": "^1.20.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.4.2",
    "@types/node-fetch": "^2.6.13",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.2"
  }
}
